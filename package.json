{
  "name": "kroma-studio",
  "version": "1.5.0",
  "description": "Kroma Studio: Estudio automatizado para la creación y montaje audiovisual con Node.js, Nuxt 3 y FFmpeg.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "collage-maker": "node ./scripts/collage.maker.js",
    "video-maker": "node ./scripts/video.maker.js",
    "lint": "eslint scripts",
    "format": "prettier --write scripts",
    "prepare": "husky install"
  },
  "author": "Jose Miguel",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/jmblanco/media-automation-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/jmblanco/media-automation-toolkit/issues"
  },
  "homepage": "https://github.com/jmblanco/media-automation-toolkit#readme",
  "keywords": [
    "media",
    "automation",
    "video",
    "audio",
    "montage",
    "nodejs",
    "toolkit",
    "nuxt",
    "vue"
  ],
  "dependencies": {
    "@nuxt/ui": "^2.18.7",
    "fluent-ffmpeg": "^2.1.3",
    "get-audio-duration": "^4.0.1",
    "lucide-vue-next": "^0.453.0",
    "nuxt": "^3.13.2",
    "sharp": "^0.34.2",
    "vue": "^3.5.11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "dotenv": "^16.0.0",
    "eslint": "^8.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.2"
  },
  "engines": {
